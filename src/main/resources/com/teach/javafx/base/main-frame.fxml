<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<!-- 前端应用主框架FXML配置文件 对应页面交互控制类 com.teach.javafx.controller.base.MainFrameController -->
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.base.MainFrameController">
  <top>
    <VBox>
      <!-- 蓝色标题栏 -->
      <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: linear-gradient(to right, #2196F3, #1976D2); -fx-padding: 12 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">
        <children>
          <!-- Logo图标 -->
          <Label text="🎓" style="-fx-font-size: 32px;" />
          
          <!-- 系统标题 -->
          <VBox spacing="2">
            <Label fx:id="systemTitle" text="602教学管理系统" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label fx:id="systemSubtitle" text="Teaching Management System - Team 602" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.85);" />
          </VBox>
          
          <!-- 弹簧 -->
          <Pane HBox.hgrow="ALWAYS" />
          
          <!-- 系统信息标签 -->
          <VBox fx:id="systemInfoBox" spacing="2" alignment="CENTER_RIGHT">
            <Label fx:id="serverInfoLabel" text="服务器: http://localhost:22222" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.9);" />
            <Label fx:id="databaseInfoLabel" text="数据库: java_server" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.9);" />
            <Label fx:id="teamInfoLabel" text="团队: 宋元明清 李松洋 李知鸿 孔令等" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.9);" />
          </VBox>

          <!-- 快速切换账户下拉框 -->
          <ComboBox fx:id="quickSwitchAccount" promptText="🔄 切换账户" prefWidth="160" style="-fx-background-color: rgba(255,255,255,0.25); -fx-mark-color: white;" />

          <!-- 欢迎信息 -->
          <Label fx:id="welcomeLabel" text="欢迎使用" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.95); -fx-padding: 0 10 0 0;" />
          
          <!-- 退出按钮 -->
          <Button fx:id="logoutButton" onAction="#onLogoutButtonClick" text="🚪 退出" style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" />
        </children>
      </HBox>
      
      <!-- 隐藏的菜单栏 -->
      <MenuBar fx:id="menuBar" visible="false" managed="false" />
    </VBox>
  </top>
  <left>
    <TreeView fx:id="menuTree" prefWidth="250" style="-fx-font-size: 14px;"/>
  </left>
  <center>
    <TabPane fx:id="contentTabPane"  tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
    </TabPane>
  </center>
  <bottom>
    <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" style="-fx-background-color: linear-gradient(to bottom, #fafafa, #f5f5f5); -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0; -fx-padding: 6 12;">
      <children>
        <Label maxHeight="1.7976931348623157E308" maxWidth="-1.0" text="Left status" HBox.hgrow="ALWAYS" fx:id="systemPrompt" >
          <font>
            <Font size="12.0" fx:id="x3" />
          </font>
          <textFill >
            <Color red="0.4" green="0.4" blue="0.4" fx:id="x4" />
          </textFill>
        </Label>
        <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
        <Label fx:id="rightStatus" font="$x3" maxWidth="-1.0" text="Right status" textFill="$x4" HBox.hgrow="NEVER" style="-fx-font-size: 12px;" />
      </children>
    </HBox>
  </bottom>
</BorderPane>
