<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="700.0" prefHeight="600.0"
            fx:controller="com.teach.javafx.controller.QuestionnaireFillController">
    <top>
        <VBox spacing="6" style="-fx-padding: 12 16; -fx-background-color: #f0f4f8;">
            <Label fx:id="titleLabel" text="问卷标题" wrapText="true"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="16">
                <Label fx:id="deadlineLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="anonymousLabel" style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
            </HBox>
            <Label fx:id="descLabel" wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 8;">
            <VBox fx:id="questionsContainer" spacing="10" style="-fx-padding: 4;"/>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 12 16; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
            <Button fx:id="submitBtn" text="提交" onAction="#onSubmitButtonClick"
                    prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
            <Button fx:id="cancelBtn" text="取消" onAction="#onCancelButtonClick"
                    prefWidth="80" style="-fx-font-size: 14px;"/>
        </HBox>
    </bottom>
</BorderPane>
