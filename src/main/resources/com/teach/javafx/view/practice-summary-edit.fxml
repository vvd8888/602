<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="550.0" prefHeight="400.0" spacing="10"
      style="-fx-padding: 16; -fx-background-color: #f8fafc;"
      fx:controller="com.teach.javafx.controller.PracticeSummaryEditController">
    <Label fx:id="dialogTitle" text="提交总结" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="总结类型" style="-fx-font-size: 13px;"/>
    <ComboBox fx:id="summaryTypeCombo" prefWidth="200" style="-fx-font-size: 13px;"
              onAction="#onSummaryTypeChanged"/>

    <Label text="标题" style="-fx-font-size: 13px;"/>
    <TextField fx:id="titleField" promptText="请输入总结标题" style="-fx-font-size: 13px;"/>

    <Label text="内容" style="-fx-font-size: 13px;"/>
    <TextArea fx:id="contentArea" prefRowCount="8" wrapText="true" promptText="请填写总结内容"
              style="-fx-font-size: 13px;" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 8 0;">
        <Button fx:id="draftBtn" text="保存草稿" onAction="#onSaveDraftButtonClick"
                prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #94a3b8; -fx-text-fill: white;"/>
        <Button fx:id="submitBtn" text="提交" onAction="#onSubmitButtonClick"
                prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
        <Button text="取消" onAction="#onCancelButtonClick"
                prefWidth="80" style="-fx-font-size: 14px; -fx-background-color: #e2e8f0; -fx-text-fill: #475569;"/>
    </HBox>
</VBox>
