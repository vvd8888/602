<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900.0" prefHeight="650.0"
            fx:controller="com.teach.javafx.controller.PracticeNormalListController">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #f0f4f8; -fx-padding: 12 16;">
                <Label text="社会实践 · 普通立项" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="+ 新建项目" onAction="#onNewButtonClick" prefWidth="100"
                        style="-fx-font-size: 13px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #f8fafc; -fx-padding: 8 16; -fx-border-color: #e2e8f0; -fx-border-width: 1 0;">
                <Label text="筛选：" style="-fx-font-size: 13px;"/>
                <ToggleButton fx:id="allFilterBtn" text="全部" prefWidth="56" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged" selected="true"/>
                <ToggleButton fx:id="draftFilterBtn" text="草稿" prefWidth="56" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="reviewFilterBtn" text="审核中" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="progressFilterBtn" text="进行中" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="summaryFilterBtn" text="待总结" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="doneFilterBtn" text="已结束" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="刷新" onAction="#onRefreshButtonClick" prefWidth="60"
                        style="-fx-font-size: 12px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.48" style="-fx-padding: 8;">
            <VBox spacing="6" style="-fx-padding: 4;">
                <Label text="我的项目" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TableView fx:id="dataTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="160" text="项目名称"/>
                        <TableColumn fx:id="teamNameColumn" prefWidth="80" text="团队"/>
                        <TableColumn fx:id="mentorColumn" prefWidth="70" text="指导老师"/>
                        <TableColumn fx:id="memberCountColumn" prefWidth="50" text="人数"/>
                        <TableColumn fx:id="statusColumn" prefWidth="80" text="状态"/>
                    </columns>
                </TableView>
            </VBox>
            <ScrollPane fitToWidth="true" style="-fx-padding: 0;">
                <VBox spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
                    <Label fx:id="detailTitleLabel" text="选择左侧项目查看详情"
                           wrapText="true"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="16">
                        <Label fx:id="detailTeamLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="detailMentorLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="detailStatusLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </HBox>
                    <Label text="项目成员：" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="detailMembersLabel" wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                    <Label text="项目说明：" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextArea fx:id="detailDescArea" editable="false" wrapText="true" prefRowCount="2"
                              style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #e2e8f0;"/>
                    <Label text="审核记录：" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextArea fx:id="detailReviewArea" editable="false" wrapText="true" prefRowCount="2"
                              style="-fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-text-fill: #64748b;"/>
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 8 0;">
                        <Button fx:id="editBtn" text="编辑" onAction="#onEditButtonClick"
                                prefWidth="80" style="-fx-font-size: 13px; -fx-background-color: #f59e0b; -fx-text-fill: white;"/>
                        <Button fx:id="submitBtn" text="提交审核" onAction="#onSubmitButtonClick"
                                prefWidth="90" style="-fx-font-size: 13px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
                        <Button fx:id="deleteBtn" text="删除" onAction="#onDeleteButtonClick"
                                prefWidth="70" style="-fx-font-size: 13px; -fx-background-color: #ef4444; -fx-text-fill: white;"/>
                        <Button fx:id="summaryBtn" text="提交总结" onAction="#onSummaryButtonClick"
                                prefWidth="90" style="-fx-font-size: 13px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
