<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900.0" prefHeight="650.0"
            fx:controller="com.teach.javafx.controller.QuestionnaireListController">
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #f0f4f8; -fx-padding: 12 16;">
                <Label text="📋 问卷填写" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #f8fafc; -fx-padding: 8 16; -fx-border-color: #e2e8f0; -fx-border-width: 1 0;">
                <Label text="筛选：" style="-fx-font-size: 13px;"/>
                <ToggleButton fx:id="allFilterBtn" text="全部" prefWidth="56" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged" selected="true"/>
                <ToggleButton fx:id="todoFilterBtn" text="待填" prefWidth="56" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <ToggleButton fx:id="doneFilterBtn" text="已填" prefWidth="56" style="-fx-font-size: 12px;"
                              onAction="#onFilterChanged"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="刷新" onAction="#onRefreshButtonClick" prefWidth="60"
                        style="-fx-font-size: 12px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.5" style="-fx-padding: 8;">
            <VBox spacing="6" style="-fx-padding: 4;">
                <Label text="问卷列表" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TableView fx:id="dataTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="180" text="标题"/>
                        <TableColumn fx:id="deadlineColumn" prefWidth="120" text="截止时间"/>
                        <TableColumn fx:id="questionCountColumn" prefWidth="60" text="题数"/>
                        <TableColumn fx:id="statusColumn" prefWidth="80" text="状态"/>
                    </columns>
                </TableView>
            </VBox>
            <ScrollPane fitToWidth="true" style="-fx-padding: 0;">
                <VBox spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
                    <Label fx:id="detailTitleLabel" text="选择左侧问卷查看详情"
                           wrapText="true"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="16">
                        <Label fx:id="detailCreatorLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="detailDeadlineLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="detailAnonymousLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    </HBox>
                    <Separator/>
                    <Label text="问卷说明：" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextArea fx:id="detailDescArea" editable="false" wrapText="true" prefRowCount="3"
                              style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #e2e8f0;"/>
                    <Label fx:id="detailInfoLabel" wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #3b82f6;"/>
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 8 0;">
                        <Button fx:id="fillBtn" text="填写问卷" onAction="#onFillButtonClick"
                                prefWidth="120" style="-fx-font-size: 14px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
                        <Button fx:id="viewBtn" text="查看回答" onAction="#onViewButtonClick"
                                prefWidth="120" style="-fx-font-size: 14px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
