<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="960.0" prefHeight="680.0"
            fx:controller="com.teach.javafx.controller.NoticeManageController">
    <top>
        <VBox spacing="0">
            <!-- 标题栏 -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #f0f4f8; -fx-padding: 12 16;">
                <Label text="📢 通知管理" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="+ 新建通知" onAction="#onNewButtonClick" prefWidth="100"
                        style="-fx-font-size: 13px; -fx-background-color: #22c55e; -fx-text-fill: white;"/>
            </HBox>
            <!-- 筛选栏 -->
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #f8fafc; -fx-padding: 8 16; -fx-border-color: #e2e8f0; -fx-border-width: 1 0;">
                <Label text="状态：" style="-fx-font-size: 13px;"/>
                <ToggleButton fx:id="allStatusBtn" text="全部" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onStatusFilterChanged" selected="true"/>
                <ToggleButton fx:id="draftStatusBtn" text="草稿" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onStatusFilterChanged"/>
                <ToggleButton fx:id="publishedStatusBtn" text="已发布" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onStatusFilterChanged"/>
                <ToggleButton fx:id="withdrawnStatusBtn" text="已撤回" prefWidth="60" style="-fx-font-size: 12px;"
                              onAction="#onStatusFilterChanged"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="刷新" onAction="#onRefreshButtonClick" prefWidth="60"
                        style="-fx-font-size: 12px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.5" style="-fx-padding: 8;">
            <!-- 左侧：通知列表 -->
            <VBox spacing="6" style="-fx-padding: 4;">
                <Label text="我的通知" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TableView fx:id="dataTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="160" text="标题"/>
                        <TableColumn fx:id="noticeTypeColumn" prefWidth="70" text="类型"/>
                        <TableColumn fx:id="statusColumn" prefWidth="60" text="状态"/>
                        <TableColumn fx:id="publishTimeColumn" prefWidth="130" text="发布时间"/>
                        <TableColumn fx:id="readInfoColumn" prefWidth="90" text="已读/总数"/>
                    </columns>
                </TableView>
            </VBox>
            <!-- 右侧：编辑区 -->
            <ScrollPane fitToWidth="true" style="-fx-padding: 0;">
                <VBox spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
                    <Label fx:id="editTitleLabel" text="编辑通知" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <!-- 标题 -->
                    <Label text="标题 *" style="-fx-font-size: 13px;"/>
                    <TextField fx:id="titleField" promptText="请输入通知标题" style="-fx-font-size: 13px;"/>

                    <!-- 类型 -->
                    <Label text="通知类型" style="-fx-font-size: 13px;"/>
                    <ComboBox fx:id="typeComboBox" prefWidth="160" style="-fx-font-size: 13px;"/>

                    <!-- 目标选择 -->
                    <Label text="发送目标" style="-fx-font-size: 13px;"/>
                    <CheckBox fx:id="allStudentCheckBox" text="全体学生" style="-fx-font-size: 13px;"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="按班级：" style="-fx-font-size: 12px;"/>
                        <ComboBox fx:id="classComboBox" prefWidth="140" style="-fx-font-size: 12px;"/>
                        <Button text="添加" onAction="#onAddClassTarget" prefWidth="50"
                                style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="指定人员ID：" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="personIdField" prefWidth="100" promptText="personId"
                                   style="-fx-font-size: 12px;"/>
                        <Button text="添加" onAction="#onAddPersonTarget" prefWidth="50"
                                style="-fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="targetSummaryLabel" wrapText="true"
                           style="-fx-font-size: 11px; -fx-text-fill: #3b82f6;"/>

                    <!-- 内容 -->
                    <Label text="通知内容" style="-fx-font-size: 13px;"/>
                    <TextArea fx:id="contentArea" prefRowCount="8" wrapText="true"
                              promptText="请输入通知内容，可包含链接"
                              style="-fx-font-size: 13px; -fx-border-color: #e2e8f0;"/>

                    <!-- 按钮区 -->
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 8 0;">
                        <Button fx:id="draftBtn" text="保存草稿" onAction="#onSaveDraftButtonClick"
                                prefWidth="90" style="-fx-font-size: 13px; -fx-background-color: #94a3b8; -fx-text-fill: white;"/>
                        <Button fx:id="publishBtn" text="发布通知" onAction="#onPublishButtonClick"
                                prefWidth="90" style="-fx-font-size: 13px; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                        <Button fx:id="withdrawBtn" text="撤回" onAction="#onWithdrawButtonClick"
                                prefWidth="70" style="-fx-font-size: 13px; -fx-background-color: #ef4444; -fx-text-fill: white;"/>
                    </HBox>
                    <!-- 已读详情按钮 -->
                    <Button fx:id="readStatusBtn" text="查看已读情况" onAction="#onViewReadStatusButtonClick"
                            prefWidth="130" style="-fx-font-size: 12px; -fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-underline: true;"/>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
